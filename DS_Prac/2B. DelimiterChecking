#2[B] WAP for Delimiter checking
def Delimiter(expr):
    stack=[]
    opening=['(','[','{']
    closing=[')',']','}']
    for char in expr:
        if char in opening:
            stack.append(char)
        elif char in closing:
            pos=closing.index(char)
            if(len(stack)>0) and opening[pos]==stack[len(stack)-1]:
                stack.pop()
            else:
                return False
    if len(stack)==0:
                return True
    else:
        return False

print("Is ('[[{([()])}]]') balanced?"+str(Delimiter('[[{([()])}]]')))
