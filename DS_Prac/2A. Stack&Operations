def createStack():
    stack=[]
def checkEmpty(stack):
    return len(stack)==0
def push(stack,item):
    stack.append(item)
    print("Pushed item:"+item)
def pop(stack):
    if checkEmpty(stack):
        return "Stack is Empty"
    return stack.pop()
